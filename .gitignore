node_modules/
dist/
.partykit/
.wrangler/
*.log
.DS_Store
.env
.env.*
!.env.example

# Local wrangler secrets. The API key is a Workers secret in production
# and must never be committed; copy .dev.vars.example to get started.
.dev.vars
.dev.vars.*
!.dev.vars.example
art-test/

# Playtest bot seats (docs/playtest.md): one run token per bot, so a rerun
# resumes the same civilizations instead of filling the cohort with abandoned
# ones. Local to a dev machine, and a credential — never committed.
.playtest/

# Production read seats (docs/prod-read.md): one credential per file, each
# one a bearer secret for a live run. The .playtest/ rationale, with higher
# stakes — these are REAL seats, and a leaked one is someone's civilization.
.seats/

# Claude Code agent worktrees (transient)
.claude/worktrees/

# Claude Code's Browser-pane dev-server config. Worktree-local by nature:
# parallel worktrees must bind DIFFERENT ports to run at once, so a shared
# copy is merge noise with no product value. The one that reached main was a
# session's own scratch config (a single entry named after its branch, with
# no client server in it) that arrived through a merge. The preview tool
# writes the file from its own schema when it is missing, so ignoring it
# costs a fresh clone nothing. settings.local.json is the same failure mode.
# settings.json, commands/ and hooks/ ARE shared project config and stay.
.claude/launch.json
.claude/settings.local.json
